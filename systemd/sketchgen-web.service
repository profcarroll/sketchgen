# sketchgen-web.service — the operator UI, a --user unit like the worker's.
#
# Binds 127.0.0.1:8081 only; reach it over an SSH tunnel:
#   ssh -f -N -L 8081:127.0.0.1:8081 sld-cloud   ->   http://localhost:8081/
# It has no authentication, which is why it must never bind anything else.
# Why a user unit: a server started from an agent's tool call dies with the
# call (dossiers/node-16x96-first-day.md §7); linger is enabled for this user.
[Unit]
Description=sketchgen operator UI on 127.0.0.1:8081 (console, queue, jobs, held)
Documentation=file:%h/sketchgen/app/docs/OPERATIONS.md
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/sketchgen/app
Environment=SKETCHGEN_DB=%h/sketchgen/sketchgen.db
Environment=SKETCHGEN_JOBS=%h/sketchgen/jobs
Environment=SKETCHGEN_GATE=%h/sketchgen/app/gate/sketch_gate.py
Environment=SKETCHGEN_GALLERY=%h/sketchgen/gallery
Environment=OLLAMA_HOST_URL=http://127.0.0.1:11434
# Where the model blobs live. The console's storage row du's this path and
# statvfs's the volume under it; on the demo node the store was moved onto a
# block volume mounted here. Ollama itself is told the same by its own unit.
Environment=OLLAMA_MODELS=/mnt/models
# Who the New job page signs jobs as, and who a critique is by: unset, the page
# asks `gh auth status` for the operator's login. Set this when gh is not on
# the node or is signed in as somebody else.
#Environment=SKETCHGEN_OPERATOR=profcarroll
# Model ids answered off the node (`sketchgen paid`), offered under "off this
# node" on New job. Names only, never a key. Must match the worker unit's line,
# or the page offers a model the worker would send to Ollama.
#Environment=SKETCHGEN_PAID_MODELS=claude-opus-5,claude-sonnet-5
ExecStart=%h/sketchgen/.venv/bin/python3 %h/sketchgen/app/bin/sketchgen web --bind 127.0.0.1 --port 8081
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
