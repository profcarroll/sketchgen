# sketchgen-sync.timer — pull from the write path every five minutes.
#
# Persistent=true catches up after a reboot or a suspended node. The service is
# a oneshot, so the timer is the only thing that starts it; enable the timer,
# not the service.
[Unit]
Description=sketchgen sync drip: every five minutes
Documentation=file:%h/sketchgen/app/docs/OPERATIONS.md

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
Persistent=true
Unit=sketchgen-sync.service

[Install]
WantedBy=timers.target
