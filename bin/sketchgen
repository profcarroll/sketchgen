#!/usr/bin/env python3
"""sketchgen — the one CLI.

Today: `db init`, `db status`, `execute`, `plan`, `install-unit`, `keygen`,
`publish`, `reject`, `worker`, `control` and `enqueue`, plus whatever
sketchgen/cli/ registers (`backup`, `gallery`, `gate-audit`, `lineage`,
`preflight`, `web`, …). Later packets add subcommands

Exit codes: 0 success, 1 failure, 3 refused.
"""

import argparse
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from sketchgen import __version__  # noqa: E402
from sketchgen import console  # noqa: E402
from sketchgen import db  # noqa: E402
from sketchgen import executor  # noqa: E402
from sketchgen import lineage  # noqa: E402
from sketchgen import planner  # noqa: E402
from sketchgen import publish as publication  # noqa: E402
from sketchgen import worker  # noqa: E402
from sketchgen import sync as sync_mod  # noqa: E402

EXIT_OK = 0
EXIT_FAIL = 1
EXIT_REFUSED = 3

REPO_ROOT = Path(__file__).resolve().parent.parent
UNIT_SOURCE_DIR = REPO_ROOT / "systemd"
UNIT_FILES = ("sketchgen-worker.service", "sketchgen-worker.timer", "sketchgen-web.service",
              "sketchgen-sync.service", "sketchgen-sync.timer",
              "sketchgen-backup.service", "sketchgen-backup.timer")

# Per key: which repo it is registered on, which permission, what it is used for.
KEY_ROLES = {
    "app": (
        "the sketchgen (app) repo",
        'READ-ONLY — do NOT tick "Allow write access"',
        "git -C ~/sketchgen/app pull",
    ),
    "gallery": (
        "the sketchgen-gallery (Pages) repo",
        'WRITE — tick "Allow write access"',
        "git -C ~/sketchgen/gallery push",
    ),
}


def _add_path_option(parser: argparse.ArgumentParser) -> None:
    # `--db` is the spelling every other subcommand uses and the one anybody
    # coming from them will type first; it is an alias here rather than a
    # second option, so `db status --db X` and `db status --path X` are the
    # same flag and cannot disagree.
    parser.add_argument(
        "--path",
        "--db",
        dest="path",
        default=db.DEFAULT_DB_PATH,
        metavar="P",
        help="database file (default: $SKETCHGEN_DB, else ~/sketchgen/sketchgen.db)",
    )


def _add_db_option(parser: argparse.ArgumentParser) -> None:
    """`--db` for the subcommands that are not under `db`, same default."""
    parser.add_argument(
        "--db",
        default=db.DEFAULT_DB_PATH,
        metavar="P",
        help="database file (default: $SKETCHGEN_DB, else ~/sketchgen/sketchgen.db)",
    )


def cmd_db_init(args: argparse.Namespace) -> int:
    """Create the database if needed and apply any unapplied migrations."""
    try:
        applied = db.init(args.path)
    except (OSError, sqlite3.Error) as exc:
        print(f"sketchgen: db init failed: {exc}", file=sys.stderr)
        return EXIT_FAIL
    conn = db.connect(args.path)
    try:
        version = db.schema_version(conn)
    finally:
        conn.close()
    if applied:
        names = ", ".join(str(v) for v in applied)
        print(f"initialised {args.path}: applied migration(s) {names}")
    else:
        print(f"up to date {args.path}: no migrations to apply")
    print(f"schema_version: {version}")
    return EXIT_OK


def cmd_db_status(args: argparse.Namespace) -> int:
    """Print schema version, tables with row counts, the control row, job counts."""
    if not os.path.exists(args.path):
        print(
            f"sketchgen: no database at {args.path} (run: sketchgen db init)",
            file=sys.stderr,
        )
        return EXIT_FAIL
    conn = db.connect(args.path)
    try:
        version = db.schema_version(conn)
        if version == 0:
            print(
                f"sketchgen: {args.path} has no schema (run: sketchgen db init)",
                file=sys.stderr,
            )
            return EXIT_FAIL
        print(f"database: {args.path}")
        print(f"schema_version: {version}")
        print("tables:")
        for name, count in db.table_counts(conn):
            print(f"  {name:<16} {count:>8}")
        control = db.get_control(conn)
        if control is None:
            print("control: MISSING")
        else:
            reason = control.reason if control.reason else "-"
            print(
                f"control: {control.state}  reason: {reason}  "
                f"updated_utc: {control.updated_utc}"
            )
        print("jobs by state:")
        for state, count in db.job_counts(conn):
            print(f"  {state:<16} {count:>8}")
        # What the worker is doing, in the one view that is available over SSH
        # with no tunnel to the operator UI. The card and this print the same
        # sentence because they read the same function.
        act = console.activity(conn)
        state = act.get("state") or "unknown"
        elapsed = act.get("elapsed_s")
        print(
            f"now: {act.get('headline') or '—'}  [{state}"
            + (f", {worker.human_gap(elapsed)}" if elapsed is not None else "")
            + "]"
        )
        if act.get("detail"):
            print(f"  {act['detail']}")
        idle = worker.idle_summary(conn)
        print("idle work:")
        for label, key in (
            ("agent verdicts", "agent_verdicts"),
            ("critiques", "critiques"),
            ("spawned children", "spawned"),
            ("rejected", "rejected"),
        ):
            print(f"  {label:<16} {idle[key]:>8}")
        print(f"  last action utc: {idle['last_action_utc'] or '-'}")
    except sqlite3.Error as exc:
        print(f"sketchgen: db status failed: {exc}", file=sys.stderr)
        return EXIT_FAIL
    finally:
        conn.close()
    return EXIT_OK


def _open_db(path: str) -> "sqlite3.Connection | None":
    """Open an initialised database, or print why we cannot and return None."""
    if not os.path.exists(path):
        print(
            f"sketchgen: no database at {path} (run: sketchgen db init)",
            file=sys.stderr,
        )
        return None
    conn = db.connect(path)
    if db.schema_version(conn) == 0:
        conn.close()
        print(
            f"sketchgen: {path} has no schema (run: sketchgen db init)",
            file=sys.stderr,
        )
        return None
    return conn


def cmd_enqueue(args: argparse.Namespace) -> int:
    """Put one job on the queue. A thin wrapper over db.enqueue, nothing more."""
    conn = _open_db(args.db)
    if conn is None:
        return EXIT_FAIL
    options: dict = {"max_attempts": args.max_attempts, "publication": args.publication}
    if args.planner:
        options["planner"] = args.planner
    if args.rules:
        options["rules_file"] = args.rules
    if args.parent is not None:
        options["parent_entry_id"] = args.parent
    try:
        job_id = db.enqueue(conn, args.prompt, args.by, **options)
    except sqlite3.Error as exc:
        print(f"sketchgen: enqueue failed: {exc}", file=sys.stderr)
        return EXIT_FAIL
    finally:
        conn.close()
    print(f"queued job {job_id}: {args.prompt}")
    return EXIT_OK


def cmd_worker(args: argparse.Namespace) -> int:
    """Run the worker: one pass with --once, or resident (systemd's mode)."""
    conn = _open_db(args.db)
    if conn is None:
        return EXIT_FAIL
    executor_fn = None
    planner_fn = None
    judge_fn = None
    critic_fn = None
    probe = None
    if any((args.stub_executor, args.stub_planner_assert,
            args.stub_judge is not None, args.stub_critic)):
        # A stubbed run calls no model, so it cannot contend for the inference
        # slot: the fence observes and reports but does not refuse. A real run
        # gets the real fence.
        probe = worker.observing_probe(args.host)
    if args.stub_executor:
        executor_fn = worker.stub_executor(args.stub_executor)
        print(
            "sketchgen: TEST MODE — the executor is stubbed; no model is called, "
            "and the fence observes the slot without refusing on it",
            file=sys.stderr,
        )
    if args.stub_judge is not None:
        judge_fn = worker.stub_judge(args.stub_judge or None)
        print(
            "sketchgen: TEST MODE — the idle judge is stubbed"
            + (f"; replaying {args.stub_judge}" if args.stub_judge
               else "; it judges nothing"),
            file=sys.stderr,
        )
    if args.stub_critic:
        stub_path = args.stub_critic

        def critic_fn(conn, entry_id, **kwargs):  # noqa: F811 — test-only stub
            """TEST ONLY: replay a saved critique instead of calling the model."""
            return lineage.critique(conn, entry_id, stub=stub_path, **kwargs)

        print(
            f"sketchgen: TEST MODE — the critic is stubbed; replaying {stub_path}",
            file=sys.stderr,
        )
    if args.stub_planner_assert:
        planner_fn = worker.stub_planner(args.stub_planner_assert)
        print(
            "sketchgen: TEST MODE — the planner is stubbed; no model is called",
            file=sys.stderr,
        )
    runner = worker.Worker(
        conn,
        jobs_dir=os.path.expanduser(args.jobs_dir),
        gate_path=os.path.expanduser(args.gate),
        host=args.host,
        executor_fn=executor_fn,
        planner_fn=planner_fn,
        judge_fn=judge_fn,
        critic_fn=critic_fn,
        probe=probe,
    )
    try:
        if args.once:
            return runner.run_once()
        return runner.run_forever(args.sleep)
    except KeyboardInterrupt:  # pragma: no cover - operator's Ctrl-C
        print("sketchgen: interrupted", file=sys.stderr)
        return EXIT_FAIL
    finally:
        conn.close()


def cmd_control(args: argparse.Namespace) -> int:
    """Set the operator's switch: pause, stop (stop now), or resume.

    `stop` is written as control state 'pausing' with a reason beginning
    'stop' — see sketchgen/worker.py's docstring for why it is a reason rather
    than a new state value.
    """
    conn = _open_db(args.db)
    if conn is None:
        return EXIT_FAIL
    try:
        if args.action == "pause":
            control = db.set_control(conn, "pausing", args.reason or "pause")
        elif args.action == "stop":
            reason = f"stop: {args.reason}" if args.reason else "stop"
            control = db.set_control(conn, "pausing", reason)
        else:
            control = db.set_control(conn, "running", args.reason)
    except sqlite3.Error as exc:
        print(f"sketchgen: control failed: {exc}", file=sys.stderr)
        return EXIT_FAIL
    finally:
        conn.close()
    print(
        f"control: {control.state}  reason: {control.reason or '-'}  "
        f"updated_utc: {control.updated_utc}"
    )
    if args.action == "pause":
        print("the worker finishes the attempt in flight, then settles into paused")
    elif args.action == "stop":
        print("the worker aborts the attempt in flight and re-queues the job")
    return EXIT_OK


def cmd_execute(args: argparse.Namespace) -> int:
    """Run one single-shot execute attempt, or replay a saved response."""
    try:
        result = executor.run(
            brief=args.brief,
            assertions=args.assertions,
            rules_file=args.rules,
            seed=args.seed,
            model=args.model,
            host=args.host,
            num_ctx=args.num_ctx,
            out_dir=args.out,
            stub=args.stub,
        )
    except executor.ExecutorRefused as exc:
        print(f"sketchgen: refused: {exc}", file=sys.stderr)
        return EXIT_REFUSED
    except OSError as exc:
        print(f"sketchgen: execute failed: {exc}", file=sys.stderr)
        return EXIT_FAIL
    if args.json:
        sys.stdout.write(result.to_json())
    elif result.ok:
        print(f"wrote {', '.join(result.files)} to {result.out_dir}")
        print(f"blocks: {', '.join(result.blocks)}")
    else:
        print(f"sketchgen: {result.error}", file=sys.stderr)
        print(f"raw response kept at {result.out_dir}/response.txt", file=sys.stderr)
    return EXIT_OK if result.ok else EXIT_FAIL
def _plan_target(conn, job_id: int):
    """The job a ``--job`` plan is for, or a refusal printed and ``None``.

    Only a job parked at ``needs-laptop`` is claimable here. Anything else is
    either finished, or in flight with the worker attending it — and a second
    writer of ``jobs.brief`` is the same class of mistake as a second worker.
    """
    job = db.get_job(conn, job_id)
    if job is None:
        print(f"sketchgen: no job {job_id}", file=sys.stderr)
        return None
    if job.state != "needs-laptop":
        print(
            f"sketchgen: job {job_id} is {job.state}, not needs-laptop — only a "
            "job waiting for the laptop can be planned here",
            file=sys.stderr,
        )
        return None
    if job.needs not in (None, "plan"):
        print(
            f"sketchgen: job {job_id} is waiting for {job.needs!r}, not a plan",
            file=sys.stderr,
        )
        return None
    return job


def cmd_plan(args: argparse.Namespace) -> int:
    """Turn one prompt into a brief and a validated assertion list.

    Writes ``plan.json`` and ``response.txt`` into --out. ``response.txt`` is
    written even when the response is unusable: the raw text is the only
    evidence of what the model actually said, and it is the thing a person
    reads when a job fails.

    With ``--job N`` the prompt comes from the job rather than the command line
    and the result goes back onto it: the brief, the assertions and the model
    that wrote them, in the one ``db.transition`` that also moves the job to
    ``executing`` — the same write the worker makes on the local path, so a job
    planned here is indistinguishable afterwards from one planned on the node.

    That is the return leg of DECIDE[credential-model] branch B. ``--planner
    paid`` parks a job at ``needs-laptop`` and until now nothing brought it
    back: the paid model's reply could be parsed with ``--stub`` and then had
    nowhere to go. The prompt needs no hash to travel with it, the way the
    judge's claims do — ``jobs.prompt`` is written once by ``enqueue`` and no
    code in this repo updates it, so what the laptop was shown is what the job
    still holds.
    """
    started = planner.utc_now()
    conn = None
    job = None
    prompt, by = args.prompt, args.by
    if args.job is not None:
        conn = _open_db(args.db)
        if conn is None:
            return EXIT_FAIL
        job = _plan_target(conn, args.job)
        if job is None:
            conn.close()
            return EXIT_REFUSED
        prompt, by = job.prompt, (args.by or job.submitted_by)
    if not args.out and job is None:
        print("sketchgen: --out is required without --job", file=sys.stderr)
        return EXIT_FAIL
    out_dir = Path(
        args.out
        if args.out
        else os.path.join(os.path.expanduser(args.jobs_dir), str(args.job))
    )
    def done(code: int) -> int:
        if conn is not None:
            conn.close()
        return code

    try:
        out_dir.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        print(f"sketchgen: cannot write to {out_dir}: {exc}", file=sys.stderr)
        return done(EXIT_FAIL)

    try:
        result = planner.plan(
            prompt,
            args.model,
            host=args.host,
            num_ctx=args.num_ctx,
            seed=args.seed,
            stub=args.stub,
            by=by,
        )
    except planner.PlannerRefused as exc:
        print(f"sketchgen: plan refused: {exc}", file=sys.stderr)
        return done(EXIT_REFUSED)
    except planner.PlannerFailed as exc:
        raw_path = out_dir / "response.txt"
        try:
            raw_path.write_text(exc.raw, encoding="utf-8")
        except OSError as write_exc:  # pragma: no cover - disk failure
            print(f"sketchgen: could not save the raw response: {write_exc}",
                  file=sys.stderr)
        else:
            print(f"sketchgen: plan failed: {exc}; raw response saved to {raw_path}",
                  file=sys.stderr)
        # The job stays parked at needs-laptop. A reply that would not parse is
        # a reply to try again, not a job to fail: the raw text is beside the
        # job and the laptop can hand back a better one under the same --job.
        if job is not None:
            print(f"sketchgen: job {job.id} is unchanged, still needs-laptop",
                  file=sys.stderr)
        return done(EXIT_FAIL)

    document = {
        "brief": result.brief,
        "assertions": result.assertions,
        "rejected": result.rejected,
        "defaulted": result.defaulted,
        "prompt_version": result.prompt_version,
        "model": args.model,
        "tokens": result.tokens,
        "durations": result.durations,
        "started_utc": started,
    }
    try:
        (out_dir / "response.txt").write_text(result.raw, encoding="utf-8")
        (out_dir / "plan.json").write_text(
            json.dumps(document, indent=2) + "\n", encoding="utf-8"
        )
    except OSError as exc:
        print(f"sketchgen: cannot write the plan to {out_dir}: {exc}", file=sys.stderr)
        return done(EXIT_FAIL)

    if job is not None:
        # The worker's own write, made from here: state, brief, assertions and
        # the model that wrote them in one statement. `planner` takes the model
        # that answered rather than the word `paid` it was queued under, for
        # the judge's reason — provenance is who answered, not who was asked.
        # `needs` is cleared by hand because `transition` does not clear it, and
        # a job left `needs='plan'` while executing reads as still waiting.
        try:
            job = db.transition(
                conn,
                job.id,
                "executing",
                brief=result.brief,
                assertions_json=json.dumps(result.assertions),
                planner=args.model,
                needs=None,
            )
        except db.IllegalTransition as exc:
            print(f"sketchgen: the plan is written to {out_dir} but job "
                  f"{args.job} did not move: {exc}", file=sys.stderr)
            return done(EXIT_FAIL)
        document["job"] = job.id

    if args.json:
        print(json.dumps(document, indent=2))
    else:
        print(f"plan: {out_dir / 'plan.json'}")
        print(f"prompt_version: {result.prompt_version}")
        print(f"assertions: {', '.join(result.assertions) or '-'}")
        if result.defaulted:
            print(f"defaulted: {', '.join(result.defaulted)}")
        for item in result.rejected:
            print(f"rejected: {item['word']}  ({item['reason']})")
        if job is not None:
            print(f"job {job.id}: planned by {args.model}, now {job.state} — "
                  "the worker takes it from here")
    return done(EXIT_OK)


def _sync_report(result: dict, as_json: bool) -> None:
    if as_json:
        print(json.dumps(result, indent=2))
        return
    print(
        f"{result['pulled_utc']}  votes {result['votes']}  likes {result['likes']}  "
        f"unlikes {result['unlikes']}  views {result['views']}  "
        f"submissions {result['submissions']}  "
        f"skipped {result['skipped']}  watermark {result['next_since']}"
    )


def cmd_sync(args: argparse.Namespace) -> int:
    """Pull the gallery write path into the app database.

    The token is read first, before the database is opened or any request is
    made: a missing or world-readable token file is a refusal, not a failure,
    and there is nothing to clean up after one.
    """
    try:
        token = sync_mod.read_token(args.token_file)
    except sync_mod.SyncRefused as exc:
        print(f"sketchgen: refused: {exc}", file=sys.stderr)
        return EXIT_REFUSED

    url = args.url or sync_mod.DEFAULT_URL
    if not url:
        print(
            "sketchgen: refused: no write path URL (pass --url, or set "
            "SKETCHGEN_WRITEPATH_URL)",
            file=sys.stderr,
        )
        return EXIT_REFUSED

    if not os.path.exists(args.db):
        print(
            f"sketchgen: no database at {args.db} (run: sketchgen db init)",
            file=sys.stderr,
        )
        return EXIT_FAIL

    conn = db.connect(args.db)
    try:
        if db.schema_version(conn) < 2:
            print(
                f"sketchgen: {args.db} is missing migration 002 "
                "(run: sketchgen db init)",
                file=sys.stderr,
            )
            return EXIT_FAIL
        while True:
            try:
                result = sync_mod.run_once(conn, url, token, timeout=args.timeout)
            except sync_mod.SyncRefused as exc:
                print(f"sketchgen: refused: {exc}", file=sys.stderr)
                return EXIT_REFUSED
            except (sync_mod.SyncFailed, sqlite3.Error) as exc:
                print(f"sketchgen: sync failed: {exc}", file=sys.stderr)
                return EXIT_FAIL
            _sync_report(result, args.json)
            if args.once:
                return EXIT_OK
            try:
                time.sleep(args.interval)
            except KeyboardInterrupt:
                return EXIT_OK
    finally:
        conn.close()


def _print_enable_help(target_dir: Path) -> None:
    """Print the two modes. This command never enables or starts anything."""
    print()
    print("nothing has been enabled or started. Pick ONE mode:")
    print()
    print("  daemon — the worker stays resident:")
    print("    systemctl --user enable --now sketchgen-worker.service")
    print()
    print("  drip — a timer wakes the worker every 5 minutes:")
    print("    systemctl --user enable --now sketchgen-worker.timer")
    print("    (leave sketchgen-worker.service disabled; the timer starts it)")
    print()
    print("  then, either way:")
    print("    systemctl --user status sketchgen-worker.service")
    print("    journalctl --user -u sketchgen-worker -n 50")
    print()
    print("  the operator UI (127.0.0.1:8081, over an SSH tunnel), independent of the mode above:")
    print("    systemctl --user enable --now sketchgen-web.service")
    print("    ssh -f -N -L 8081:127.0.0.1:8081 sld-cloud   # from the laptop, then http://localhost:8081/")
    print()
    print("  the write-path sync (votes, likes, views), a five-minute drip; needs ~/sketchgen/writepath.token:")
    print("    systemctl --user enable --now sketchgen-sync.timer")
    print()
    print("  the nightly backup (04:10 UTC) — the record's only copy is on this instance:")
    print("    systemctl --user enable --now sketchgen-backup.timer")
    print("    python3 bin/sketchgen backup snapshot --to ~/sketchgen/backups   # take the first one now")
    print("    (and on the OPERATOR's machine: bin/pull-backup.sh, which is the copy that leaves)")
    print()
    print(f"  units installed under: {target_dir}")


def cmd_install_unit(args: argparse.Namespace) -> int:
    """Copy both unit files under ~/.config/systemd/user and reload the manager.

    Enabling and starting are the operator's, not this command's.
    """
    target_dir = Path.home() / ".config" / "systemd" / "user"
    sources = [(name, UNIT_SOURCE_DIR / name) for name in UNIT_FILES]
    missing = [str(path) for _, path in sources if not path.is_file()]
    if missing:
        for path in missing:
            print(f"sketchgen: missing unit file: {path}", file=sys.stderr)
        return EXIT_FAIL

    if args.dry_run:
        print("dry run: nothing copied, nothing reloaded, nothing enabled")
        for name, source in sources:
            print(f"would copy {source} -> {target_dir / name}")
        print("would run: systemctl --user daemon-reload")
        _print_enable_help(target_dir)
        return EXIT_OK

    try:
        target_dir.mkdir(parents=True, exist_ok=True)
        for name, source in sources:
            shutil.copyfile(source, target_dir / name)
            print(f"copied {source} -> {target_dir / name}")
    except OSError as exc:
        print(f"sketchgen: install-unit failed: {exc}", file=sys.stderr)
        return EXIT_FAIL

    systemctl = shutil.which("systemctl")
    if systemctl is None:
        print(
            "sketchgen: systemctl not found; files are in place but the manager "
            "was not reloaded",
            file=sys.stderr,
        )
        return EXIT_FAIL
    result = subprocess.run(
        [systemctl, "--user", "daemon-reload"],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        sys.stderr.write(result.stderr)
        print("sketchgen: systemctl --user daemon-reload failed", file=sys.stderr)
        return EXIT_FAIL
    print("ran: systemctl --user daemon-reload")
    _print_enable_help(target_dir)
    return EXIT_OK


def cmd_keygen(args: argparse.Namespace) -> int:
    """Generate one scoped ed25519 deploy key and print only its public half."""
    which = args.which
    repo, permission, usage = KEY_ROLES[which]
    comment = f"sketchgen-{which}-deploy"
    directory = Path(os.path.expanduser(args.dir))
    private = directory / f"sketchgen-{which}"
    public = directory / f"sketchgen-{which}.pub"

    if private.exists() or public.exists():
        print(
            f"sketchgen: refusing: a key is already at {private} — "
            "delete or move it yourself if you really mean to replace it",
            file=sys.stderr,
        )
        return EXIT_REFUSED

    ssh_keygen = shutil.which("ssh-keygen")
    if ssh_keygen is None:
        print("sketchgen: ssh-keygen not found on PATH", file=sys.stderr)
        return EXIT_FAIL

    if args.dry_run:
        print("dry run: no key generated, nothing written")
        print(f"would run: ssh-keygen -t ed25519 -N '' -C '{comment}' -f {private}")
        print(f"would write: {private} (mode 0600) and {public} (mode 0644)")
        print(f"would print the public half of {public} and nothing else")
        print(f"register: on {repo}, as a deploy key, {permission}")
        print(
            f"use: GIT_SSH_COMMAND='ssh -i {private} -o IdentitiesOnly=yes' {usage}"
        )
        return EXIT_OK

    try:
        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    except OSError as exc:
        print(f"sketchgen: cannot create {directory}: {exc}", file=sys.stderr)
        return EXIT_FAIL

    result = subprocess.run(
        [ssh_keygen, "-t", "ed25519", "-N", "", "-C", comment, "-f", str(private)],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        sys.stderr.write(result.stderr)
        print("sketchgen: ssh-keygen failed", file=sys.stderr)
        return EXIT_FAIL

    try:
        os.chmod(private, 0o600)
        os.chmod(public, 0o644)
        public_half = public.read_text(encoding="utf-8").strip()
    except OSError as exc:
        print(f"sketchgen: key written but unusable: {exc}", file=sys.stderr)
        return EXIT_FAIL

    print(public_half)
    print(f"register: add the line above to {repo} as a deploy key, {permission}")
    print(f"private half: {private} (mode 0600) — never commit it, never paste it")
    print(f"use: GIT_SSH_COMMAND='ssh -i {private} -o IdentitiesOnly=yes' {usage}")
    return EXIT_OK


def _open_db(path: str):
    """Open an existing database, or refuse. Never creates one by accident."""
    if not os.path.exists(path):
        raise publication.PublishRefused(
            f"no database at {path} (run: sketchgen db init)"
        )
    return db.connect(path)


def cmd_publish(args: argparse.Namespace) -> int:
    """Commit and push one held entry into the gallery repository."""
    try:
        conn = _open_db(args.db)
    except publication.PublishRefused as exc:
        print(f"sketchgen: refused: {exc}", file=sys.stderr)
        return EXIT_REFUSED
    try:
        result = publication.publish(
            conn,
            args.entry_id,
            gallery_dir=args.gallery_dir,
            from_dir=getattr(args, "from_dir"),
            key=args.key,
            remote=args.remote,
            by=args.by,
            model=args.model,
            url_base=args.url,
            dry_run=args.dry_run,
        )
    except publication.PublishRefused as exc:
        print(f"sketchgen: refused: {exc}", file=sys.stderr)
        return EXIT_REFUSED
    except publication.PublishFailed as exc:
        print(f"sketchgen: publish failed: {exc}", file=sys.stderr)
        return EXIT_FAIL
    except OSError as exc:
        print(f"sketchgen: publish failed: {exc}", file=sys.stderr)
        return EXIT_FAIL
    finally:
        conn.close()

    if isinstance(result, publication.Plan):
        print("dry run: nothing copied, nothing committed, nothing pushed")
        print(f"entry {result.entry_id} ({result.state}) from {result.source_dir}")
        for name in result.files:
            print(f"would copy {name} -> {result.dest}/{name}")
        print("would commit with this message:")
        for line in result.message.rstrip("\n").splitlines():
            print(f"  {line}")
        print(f"would run: {result.push_command}")
        print(f"would appear at: {result.url}")
        return EXIT_OK

    print(result.commit)
    print(result.url)
    if result.index_commit:
        print(f"index {result.index_commit}")
    elif result.index_note:
        print(f"index: {result.index_note}", file=sys.stderr)
    return EXIT_OK


def cmd_reject(args: argparse.Namespace) -> int:
    """Mark a held entry rejected. No git, no files, no push."""
    try:
        conn = _open_db(args.db)
    except publication.PublishRefused as exc:
        print(f"sketchgen: refused: {exc}", file=sys.stderr)
        return EXIT_REFUSED
    try:
        publication.reject(conn, args.entry_id, args.reason)
    except publication.PublishRefused as exc:
        print(f"sketchgen: refused: {exc}", file=sys.stderr)
        return EXIT_REFUSED
    except sqlite3.Error as exc:
        print(f"sketchgen: reject failed: {exc}", file=sys.stderr)
        return EXIT_FAIL
    finally:
        conn.close()
    if args.reason:
        print(f"entry {args.entry_id}: rejected ({args.reason})")
    else:
        print(f"entry {args.entry_id}: rejected")
    return EXIT_OK


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="sketchgen",
        description="sketchgen: queue, worker and gallery for self-hosted p5 sketches.",
    )
    parser.add_argument("--version", action="version", version=f"sketchgen {__version__}")
    top = parser.add_subparsers(dest="group", metavar="COMMAND")

    db_parser = top.add_parser("db", help="create and inspect the database")
    db_sub = db_parser.add_subparsers(dest="command", metavar="SUBCOMMAND")

    init_parser = db_sub.add_parser("init", help="create the database and migrate it")
    _add_path_option(init_parser)
    init_parser.set_defaults(func=cmd_db_init)

    status_parser = db_sub.add_parser("status", help="print what is in the database")
    _add_path_option(status_parser)
    status_parser.set_defaults(func=cmd_db_status)

    db_parser.set_defaults(_parser=db_parser)

    enqueue_parser = top.add_parser(
        "enqueue",
        help="put one prompt on the queue",
        description=(
            "Add one job to the queue. A thin wrapper over db.enqueue: it "
            "validates nothing the schema does not already validate, and it "
            "calls no model. GitHub usernames only for --by."
        ),
    )
    enqueue_parser.add_argument("--prompt", required=True, metavar="TEXT",
                                help="what to make")
    enqueue_parser.add_argument("--by", required=True, metavar="USERNAME",
                                help="GitHub username of the submitter")
    enqueue_parser.add_argument("--planner", choices=("local", "paid"), default=None,
                                help="who writes the brief; 'paid' stops the job at "
                                     "needs-laptop (DECIDE[credential-model] B)")
    enqueue_parser.add_argument("--rules", choices=("control", "treatment", "random"),
                                default=None,
                                help="rules file for the executor; 'random' resolves "
                                     "per job id at execute time (spec §9)")
    enqueue_parser.add_argument("--publication", choices=("hold", "auto"),
                                default="hold",
                                help="hold for a person (default) or auto-publish "
                                     "later; both land in held for now")
    enqueue_parser.add_argument("--max-attempts", dest="max_attempts", type=int,
                                default=3, metavar="N",
                                help="execute+gate attempts before failed (default 3)")
    enqueue_parser.add_argument("--parent", type=int, default=None, metavar="ID",
                                help="entry id this prompt came from (lineage)")
    _add_db_option(enqueue_parser)
    enqueue_parser.set_defaults(func=cmd_enqueue, _parser=enqueue_parser)

    worker_parser = top.add_parser(
        "worker",
        help="claim one queued job and take it to held or failed",
        description=(
            "The worker loop. Without --once it stays resident and polls, which "
            "is what the systemd user unit runs; never start that from a tool "
            "call, it dies with the call. It fences the inference slot before "
            "claiming anything and refuses (exit 3) while another client holds "
            "it, and it honours the control row: pause finishes the attempt in "
            "flight, stop aborts and re-queues."
        ),
    )
    worker_parser.add_argument("--once", action="store_true",
                               help="one pass, at most one job, then exit")
    _add_db_option(worker_parser)
    worker_parser.add_argument("--jobs-dir", dest="jobs_dir",
                               default=worker.DEFAULT_JOBS_DIR, metavar="D",
                               help="per-job directories and job.log "
                                    "(default: $SKETCHGEN_JOBS, else ~/sketchgen/jobs)")
    worker_parser.add_argument("--gate", default=worker.DEFAULT_GATE_PATH, metavar="PATH",
                               help="sketch_gate.py (default: $SKETCHGEN_GATE, else "
                                    "~/sketchgen/gate/sketch_gate.py)")
    worker_parser.add_argument("--host", default=worker.DEFAULT_HOST, metavar="URL",
                               help="Ollama base URL (default: $OLLAMA_HOST_URL, else "
                                    "http://127.0.0.1:11434)")
    worker_parser.add_argument("--sleep", type=float, default=worker.DEFAULT_SLEEP_S,
                               metavar="S",
                               help="seconds between passes when resident "
                                    f"(default {worker.DEFAULT_SLEEP_S:.0f})")
    worker_parser.add_argument("--stub-executor", dest="stub_executor", default=None,
                               metavar="DIR",
                               help="TEST ONLY: copy DIR as the executor's output "
                                    "instead of calling the model; the run calls no "
                                    "model, so the fence reports the slot without "
                                    "refusing on it")
    worker_parser.add_argument("--stub-planner-assert", dest="stub_planner_assert",
                               action="append", default=[], metavar="WORD",
                               help="TEST ONLY: plan with the job's own prompt as the "
                                    "brief and these assertions; repeatable")
    worker_parser.add_argument("--stub-judge", dest="stub_judge", nargs="?", const="",
                               default=None, metavar="FILE",
                               help="TEST ONLY: the idle judge replays FILE, or "
                                    "judges nothing when given no FILE")
    worker_parser.add_argument("--stub-critic", dest="stub_critic", default=None,
                               metavar="FILE",
                               help="TEST ONLY: the idle critic replays this saved "
                                    "critique instead of calling the model")
    worker_parser.set_defaults(func=cmd_worker, _parser=worker_parser)

    control_parser = top.add_parser(
        "control",
        help="pause, stop now, or resume the worker",
        description=(
            "The operator's one switch, held in the database so it survives a "
            "worker restart and does not fight systemd. pause: finish the "
            "attempt in flight, then stop. stop: abort the attempt in flight "
            "and re-queue the job. resume: take jobs again."
        ),
    )
    control_parser.add_argument("action", choices=("pause", "stop", "resume"),
                                help="what to ask the worker for")
    control_parser.add_argument("--reason", default=None, metavar="TEXT",
                                help="why, for the record and for the console")
    _add_db_option(control_parser)
    control_parser.set_defaults(func=cmd_control, _parser=control_parser)

    ex = top.add_parser(
        "execute",
        help="one prompt in, one sketch out (single-shot, no agent loop)",
        description=(
            "Send one brief to the executor model and write sketch.js, index.html, "
            "statement.md, response.txt and result.json into --out."
        ),
        epilog="assertion vocabulary: " + ", ".join(executor.VOCAB),
    )
    ex.add_argument("--brief", required=True, metavar="TEXT", help="what to make")
    ex.add_argument(
        "--assert",
        dest="assertions",
        action="append",
        default=[],
        metavar="WORD",
        help="assertion the sketch must pass; repeatable",
    )
    ex.add_argument(
        "--rules",
        default="treatment",
        metavar="R",
        help="rules file: treatment, control, or a path (default: treatment)",
    )
    ex.add_argument(
        "--model", default=executor.DEFAULT_MODEL, metavar="M", help="Ollama model tag"
    )
    ex.add_argument(
        "--host", default=executor.DEFAULT_HOST, metavar="URL", help="Ollama base URL"
    )
    ex.add_argument("--out", required=True, metavar="DIR", help="output directory")
    ex.add_argument(
        "--stub",
        metavar="FILE",
        help="replay a saved raw response instead of calling the model",
    )
    ex.add_argument(
        "--seed", type=int, default=executor.DEFAULT_SEED, metavar="N", help="p5 seed"
    )
    ex.add_argument(
        "--num-ctx",
        dest="num_ctx",
        type=int,
        default=executor.DEFAULT_NUM_CTX,
        metavar="N",
        help=f"context window (default: {executor.DEFAULT_NUM_CTX})",
    )
    ex.add_argument("--json", action="store_true", help="print result.json to stdout")
    ex.set_defaults(func=cmd_execute, _parser=ex)
    plan_parser = top.add_parser(
        "plan",
        help="expand a prompt into a brief and a validated assertion list",
        description="Expand one prompt into a brief and a list of gate assertions "
                    "drawn only from the runner's closed vocabulary. With --job "
                    "the prompt comes from a job parked at needs-laptop and the "
                    "result is written back onto it, which is the return leg of "
                    "the paid planner path: --planner paid parks the job, the "
                    "laptop asks the model that holds the credential, and "
                    "--stub replays its reply through this same parser.",
    )
    plan_source = plan_parser.add_mutually_exclusive_group(required=True)
    plan_source.add_argument("--prompt", help="the submitted prompt")
    plan_source.add_argument("--job", type=int, metavar="N",
                             help="plan job N, which must be waiting at "
                                  "needs-laptop: its prompt is used, and the "
                                  "brief, the assertions and --model are written "
                                  "back as it moves to executing")
    plan_parser.add_argument("--by", default="", metavar="USERNAME",
                             help="GitHub username of the submitter, for the "
                                  "record (default: the job's, with --job)")
    plan_parser.add_argument("--model", required=True, metavar="M",
                             help="model tag, e.g. gemma4:e4b, or the paid model "
                                  "that answered when replaying one with --stub")
    plan_parser.add_argument("--out", default=None, metavar="DIR",
                             help="directory for plan.json and response.txt "
                                  "(default with --job: <jobs-dir>/<N>)")
    plan_parser.add_argument("--jobs-dir", dest="jobs_dir",
                             default=worker.DEFAULT_JOBS_DIR, metavar="D",
                             help="where --job looks for its job directory "
                                  "(default: $SKETCHGEN_JOBS, else "
                                  "~/sketchgen/jobs)")
    plan_parser.add_argument("--stub", default=None, metavar="FILE",
                             help="replay this saved response; calls no model")
    plan_parser.add_argument("--host", default=planner.DEFAULT_HOST,
                             help=f"Ollama host (default: {planner.DEFAULT_HOST})")
    plan_parser.add_argument("--num-ctx", type=int, default=8192, metavar="N",
                             help="context window for the call (default 8192)")
    plan_parser.add_argument("--seed", type=int, default=1, metavar="N",
                             help="sampling seed (default 1)")
    plan_parser.add_argument("--json", action="store_true",
                             help="print plan.json to stdout as well")
    _add_db_option(plan_parser)
    plan_parser.set_defaults(func=cmd_plan, _parser=plan_parser)
    sync_parser = top.add_parser(
        "sync",
        help="pull gallery votes, likes and views into the database",
        description=(
            "Pull GET /pull from the gallery write path Worker and write the "
            "result into this node's database: votes become human judgments, "
            "likes become likes, view counts become engagement.views. The "
            "watermark lives in sync_state, so a pull resumes where the last "
            "one stopped. This is the only route the node calls, and the node "
            "listens on nothing."
        ),
        epilog=(
            "The bearer token is read from a file, never from the command line, "
            "and the file must be mode 0600."
        ),
    )
    sync_parser.add_argument(
        "--db",
        default=db.DEFAULT_DB_PATH,
        metavar="P",
        help="database file (default: $SKETCHGEN_DB, else ~/sketchgen/sketchgen.db)",
    )
    sync_parser.add_argument(
        "--url",
        default=sync_mod.DEFAULT_URL,
        metavar="URL",
        help="write path base URL (default: $SKETCHGEN_WRITEPATH_URL)",
    )
    sync_parser.add_argument(
        "--token-file",
        dest="token_file",
        default=sync_mod.DEFAULT_TOKEN_FILE,
        metavar="F",
        help=f"file holding the pull token, mode 0600 (default: {sync_mod.DEFAULT_TOKEN_FILE})",
    )
    sync_parser.add_argument(
        "--once",
        action="store_true",
        help="pull once and exit; this is what the worker loop and the timer use",
    )
    sync_parser.add_argument(
        "--interval",
        type=float,
        default=300.0,
        metavar="S",
        help="seconds between pulls when --once is not given (default: 300)",
    )
    sync_parser.add_argument(
        "--timeout",
        type=float,
        default=sync_mod.DEFAULT_TIMEOUT,
        metavar="S",
        help=f"HTTP timeout in seconds (default: {sync_mod.DEFAULT_TIMEOUT:g})",
    )
    sync_parser.add_argument(
        "--json", action="store_true", help="print the result as JSON"
    )
    sync_parser.set_defaults(func=cmd_sync, _parser=sync_parser)

    install_parser = top.add_parser(
        "install-unit",
        help="copy the systemd --user unit files into place (enables nothing)",
        description=(
            "Copy systemd/sketchgen-worker.{service,timer} to "
            "~/.config/systemd/user/ and reload the user manager. It prints the "
            "enable/start commands for daemon mode and for drip mode; it never "
            "runs them."
        ),
    )
    install_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print what would be copied and where, then exit without writing",
    )
    install_parser.set_defaults(func=cmd_install_unit, _parser=install_parser)

    keygen_parser = top.add_parser(
        "keygen",
        help="generate one scoped ed25519 deploy key (app = read, gallery = write)",
        description=(
            "Generate an ed25519 deploy key at DIR/sketchgen-<which>, print its "
            "PUBLIC half with the one line the instructor needs to register it, "
            "and print the GIT_SSH_COMMAND that uses it. The private half is "
            "written with mode 0600 and is never printed. Refuses (exit 3) if a "
            "key of that name already exists."
        ),
    )
    keygen_parser.add_argument(
        "which",
        choices=sorted(KEY_ROLES),
        help="app (read-only, pulls the app repo) or gallery (write, pushes Pages)",
    )
    keygen_parser.add_argument(
        "--dir",
        default="~/.ssh",
        metavar="DIR",
        help="directory to write the pair into (default: ~/.ssh)",
    )
    keygen_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print what would be generated and where, then exit without writing",
    )
    keygen_parser.set_defaults(func=cmd_keygen, _parser=keygen_parser)

    publish_parser = top.add_parser(
        "publish",
        help="commit and push one held entry into the public gallery",
        description=(
            "Copy an entry's files into e/<id>/ inside the gallery checkout, "
            "commit them with the executor model and the publishing username "
            "in the trailers, and push over the write-only deploy key. The "
            "database row becomes 'published' only after the push succeeds; a "
            "failed push undoes the local commit and changes nothing. Refuses "
            "(exit 3) unless the entry is held or failed-kept, the checkout is "
            "clean and on its default branch, and no file carries an email "
            "address or the node's hostname."
        ),
    )
    publish_parser.add_argument(
        "entry_id", type=int, metavar="ENTRY_ID", help="the entry to publish"
    )
    publish_parser.add_argument(
        "--db",
        default=db.DEFAULT_DB_PATH,
        metavar="P",
        help="database file (default: $SKETCHGEN_DB, else ~/sketchgen/sketchgen.db)",
    )
    publish_parser.add_argument(
        "--gallery-dir",
        default=publication.DEFAULT_GALLERY_DIR,
        metavar="D",
        help=(
            "checkout of the gallery repo (default: $SKETCHGEN_GALLERY, else "
            "~/sketchgen/gallery)"
        ),
    )
    publish_parser.add_argument(
        "--from",
        dest="from_dir",
        default=None,
        metavar="DIR",
        help="directory whose contents become e/<id>/ (default: ask the generator)",
    )
    publish_parser.add_argument(
        "--key",
        default=publication.DEFAULT_KEY_PATH,
        metavar="F",
        help=(
            "deploy key for an ssh remote (default: $SKETCHGEN_GALLERY_KEY, else "
            "~/.ssh/sketchgen-gallery); unused for a local remote"
        ),
    )
    publish_parser.add_argument(
        "--remote",
        default=None,
        metavar="URL",
        help="push here instead of the checkout's 'origin'",
    )
    publish_parser.add_argument(
        "--by",
        default=None,
        metavar="USERNAME",
        help="GitHub username of the person publishing (default: the OS user)",
    )
    publish_parser.add_argument(
        "--model",
        default=None,
        metavar="M",
        help="executor model id for the commit trailer (default: the entry's own)",
    )
    publish_parser.add_argument(
        "--url",
        default=publication.DEFAULT_URL_BASE,
        metavar="BASE",
        help=f"public site base (default: {publication.DEFAULT_URL_BASE})",
    )
    publish_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the files, the commit message and the push command; change nothing",
    )
    publish_parser.set_defaults(func=cmd_publish, _parser=publish_parser)

    reject_parser = top.add_parser(
        "reject",
        help="mark a held entry rejected (no git, nothing published)",
        description=(
            "Move a held entry to 'rejected'. Nothing is committed, pushed or "
            "deleted; the entry simply stops being a candidate for the gallery. "
            "A --reason is recorded on the originating job."
        ),
    )
    reject_parser.add_argument(
        "entry_id", type=int, metavar="ENTRY_ID", help="the entry to reject"
    )
    reject_parser.add_argument(
        "--db",
        default=db.DEFAULT_DB_PATH,
        metavar="P",
        help="database file (default: $SKETCHGEN_DB, else ~/sketchgen/sketchgen.db)",
    )
    reject_parser.add_argument(
        "--reason", default=None, metavar="TEXT", help="why, for the record"
    )
    reject_parser.set_defaults(func=cmd_reject, _parser=reject_parser)

    parser.set_defaults(_parser=parser)
    # Later packets add subcommands as sketchgen/cli/<name>.py exposing
    # register(top: argparse._SubParsersAction) -> None, so they never edit
    # this file and cannot conflict with each other.
    import importlib
    import pkgutil
    from sketchgen import cli as _cli
    for _mod in sorted(m.name for m in pkgutil.iter_modules(_cli.__path__)):
        importlib.import_module(f"sketchgen.cli.{_mod}").register(top)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    func = getattr(args, "func", None)
    if func is None:
        args._parser.print_help()
        return EXIT_REFUSED
    return func(args)


if __name__ == "__main__":
    sys.exit(main())
