#!/usr/bin/env python3
"""sketchgen — the one CLI.

Today: `db init`, `db status` and `execute`. Later packets add subcommands
(worker, publish, web, judge) by adding a parser and one function each, below.

Exit codes: 0 success, 1 failure, 3 refused.
"""

import argparse
import os
import sqlite3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from sketchgen import __version__  # noqa: E402
from sketchgen import db  # noqa: E402
from sketchgen import executor  # noqa: E402

EXIT_OK = 0
EXIT_FAIL = 1
EXIT_REFUSED = 3


def _add_path_option(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--path",
        default=db.DEFAULT_DB_PATH,
        metavar="P",
        help="database file (default: $SKETCHGEN_DB, else ~/sketchgen/sketchgen.db)",
    )


def cmd_db_init(args: argparse.Namespace) -> int:
    """Create the database if needed and apply any unapplied migrations."""
    try:
        applied = db.init(args.path)
    except (OSError, sqlite3.Error) as exc:
        print(f"sketchgen: db init failed: {exc}", file=sys.stderr)
        return EXIT_FAIL
    conn = db.connect(args.path)
    try:
        version = db.schema_version(conn)
    finally:
        conn.close()
    if applied:
        names = ", ".join(str(v) for v in applied)
        print(f"initialised {args.path}: applied migration(s) {names}")
    else:
        print(f"up to date {args.path}: no migrations to apply")
    print(f"schema_version: {version}")
    return EXIT_OK


def cmd_db_status(args: argparse.Namespace) -> int:
    """Print schema version, tables with row counts, the control row, job counts."""
    if not os.path.exists(args.path):
        print(
            f"sketchgen: no database at {args.path} (run: sketchgen db init)",
            file=sys.stderr,
        )
        return EXIT_FAIL
    conn = db.connect(args.path)
    try:
        version = db.schema_version(conn)
        if version == 0:
            print(
                f"sketchgen: {args.path} has no schema (run: sketchgen db init)",
                file=sys.stderr,
            )
            return EXIT_FAIL
        print(f"database: {args.path}")
        print(f"schema_version: {version}")
        print("tables:")
        for name, count in db.table_counts(conn):
            print(f"  {name:<16} {count:>8}")
        control = db.get_control(conn)
        if control is None:
            print("control: MISSING")
        else:
            reason = control.reason if control.reason else "-"
            print(
                f"control: {control.state}  reason: {reason}  "
                f"updated_utc: {control.updated_utc}"
            )
        print("jobs by state:")
        for state, count in db.job_counts(conn):
            print(f"  {state:<16} {count:>8}")
    except sqlite3.Error as exc:
        print(f"sketchgen: db status failed: {exc}", file=sys.stderr)
        return EXIT_FAIL
    finally:
        conn.close()
    return EXIT_OK


def cmd_execute(args: argparse.Namespace) -> int:
    """Run one single-shot execute attempt, or replay a saved response."""
    try:
        result = executor.run(
            brief=args.brief,
            assertions=args.assertions,
            rules_file=args.rules,
            seed=args.seed,
            model=args.model,
            host=args.host,
            num_ctx=args.num_ctx,
            out_dir=args.out,
            stub=args.stub,
        )
    except executor.ExecutorRefused as exc:
        print(f"sketchgen: refused: {exc}", file=sys.stderr)
        return EXIT_REFUSED
    except OSError as exc:
        print(f"sketchgen: execute failed: {exc}", file=sys.stderr)
        return EXIT_FAIL
    if args.json:
        sys.stdout.write(result.to_json())
    elif result.ok:
        print(f"wrote {', '.join(result.files)} to {result.out_dir}")
        print(f"blocks: {', '.join(result.blocks)}")
    else:
        print(f"sketchgen: {result.error}", file=sys.stderr)
        print(f"raw response kept at {result.out_dir}/response.txt", file=sys.stderr)
    return EXIT_OK if result.ok else EXIT_FAIL


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="sketchgen",
        description="sketchgen: queue, worker and gallery for self-hosted p5 sketches.",
    )
    parser.add_argument("--version", action="version", version=f"sketchgen {__version__}")
    top = parser.add_subparsers(dest="group", metavar="COMMAND")

    db_parser = top.add_parser("db", help="create and inspect the database")
    db_sub = db_parser.add_subparsers(dest="command", metavar="SUBCOMMAND")

    init_parser = db_sub.add_parser("init", help="create the database and migrate it")
    _add_path_option(init_parser)
    init_parser.set_defaults(func=cmd_db_init)

    status_parser = db_sub.add_parser("status", help="print what is in the database")
    _add_path_option(status_parser)
    status_parser.set_defaults(func=cmd_db_status)

    db_parser.set_defaults(_parser=db_parser)

    ex = top.add_parser(
        "execute",
        help="one prompt in, one sketch out (single-shot, no agent loop)",
        description=(
            "Send one brief to the executor model and write sketch.js, index.html, "
            "statement.md, response.txt and result.json into --out."
        ),
        epilog="assertion vocabulary: " + ", ".join(executor.VOCAB),
    )
    ex.add_argument("--brief", required=True, metavar="TEXT", help="what to make")
    ex.add_argument(
        "--assert",
        dest="assertions",
        action="append",
        default=[],
        metavar="WORD",
        help="assertion the sketch must pass; repeatable",
    )
    ex.add_argument(
        "--rules",
        default="treatment",
        metavar="R",
        help="rules file: treatment, control, or a path (default: treatment)",
    )
    ex.add_argument(
        "--model", default=executor.DEFAULT_MODEL, metavar="M", help="Ollama model tag"
    )
    ex.add_argument(
        "--host", default=executor.DEFAULT_HOST, metavar="URL", help="Ollama base URL"
    )
    ex.add_argument("--out", required=True, metavar="DIR", help="output directory")
    ex.add_argument(
        "--stub",
        metavar="FILE",
        help="replay a saved raw response instead of calling the model",
    )
    ex.add_argument(
        "--seed", type=int, default=executor.DEFAULT_SEED, metavar="N", help="p5 seed"
    )
    ex.add_argument(
        "--num-ctx",
        dest="num_ctx",
        type=int,
        default=executor.DEFAULT_NUM_CTX,
        metavar="N",
        help=f"context window (default: {executor.DEFAULT_NUM_CTX})",
    )
    ex.add_argument("--json", action="store_true", help="print result.json to stdout")
    ex.set_defaults(func=cmd_execute, _parser=ex)

    parser.set_defaults(_parser=parser)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    func = getattr(args, "func", None)
    if func is None:
        args._parser.print_help()
        return EXIT_REFUSED
    return func(args)


if __name__ == "__main__":
    sys.exit(main())
