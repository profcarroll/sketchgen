#!/bin/bash
# kiosk-status — what the laptop runs:  ssh d12-kiosk kiosk-status
# DRAFT: finalize in the on-device session (docs/plans/kiosk-mac.md §3).
STATE="$HOME/Library/Caches/sketchgen-kiosk"
echo "host      $(hostname -s)   $(uptime | sed 's/^ *//')"
echo "agent     $(launchctl print "gui/$(id -u)/org.sketchgen.kiosk" 2>/dev/null \
    | awk '/^\tstate =/{s=$3} /^\tpid =/{p=$3} /last exit code/{e=$NF} END{print s" pid="p" last_exit="e}')"
echo "chrome    $(ps -axo rss,command | grep 'sketchgen-kiosk-chrome' | grep -v grep \
    | awk '{kb+=$1; n++} END{printf "%d processes, %.0f MB resident\n", n, kb/1024}')"
echo "title     $(curl -fsS --max-time 5 http://127.0.0.1:9222/json/list 2>/dev/null \
    | grep -m1 '"title"' | sed -e 's/.*"title": *"//' -e 's/",*$//')"
echo "memory    $(memory_pressure | tail -1)"
echo "tailscale $(tailscale status --self --peers=false 2>/dev/null | head -1)"
echo "watchdog (last 5):"; tail -5 "$STATE/watchdog.log" 2>/dev/null | sed 's/^/  /'
