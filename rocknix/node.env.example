# node.env — this handheld's settings, read by every sketchgen unit (EnvironmentFile).
# Written once by rocknix/install.sh from its flags and never overwritten; edit it here.
# systemd syntax: no quotes needed, no shell expansion, one VAR=value per line.

# The model that answers plan, judge and critique, under llama.cpp's own server: the
# language model on the four big cores, the vision encoder on the Adreno through Turnip
# (the lab's patched build, rocknix/install.sh puts it in /storage/sketchgen/turnip; the
# OpenCL build cannot run the encoder, 2026-10-09). LLAMA_ENV is sourced first: it names
# the Turnip ICD and the lab's Vulkan tuning. For a CPU-only encoder: LLAMA_ENV=/dev/null
# and LLAMA_ARGS without -mmdev — and expect minutes per judgement.
LLAMA_SERVER=/storage/ollamadreno/bin-no8/llama-server
LLAMA_MODEL=/storage/games-external/models/gemma-4-E4B_q4_0-it.gguf
LLAMA_MMPROJ=/storage/games-external/models/gemma-4-E4B-it-mmproj.gguf
LLAMA_ENV=/storage/sketchgen/turnip/env.sh
LLAMA_ARGS=-dev none -mmdev Vulkan0 -fa off --jinja -rea off -t 4 -c 8192 -np 1 --cache-ram 0
LLAMA_CPUS=4-7
LLAMA_PORT=8092

# The shim's own options. --max-image-px shrinks what the judge and critic are shown so
# the encoder prices one tile per strip rather than a dozen; the files on disk are untouched
# and the shim's log line says what was shown.
SHIM_ARGS=--max-image-px 1280

# What the records call that model. Not gemma4:e4b: that is Ollama's Q4_K_M, and the
# model id on an attempt is the model that answered, never a near one.
SKETCHGEN_PLANNER_MODEL=gemma4:e4b-qat-q4_0
SKETCHGEN_JUDGE_MODEL=gemma4:e4b-qat-q4_0
SKETCHGEN_CRITIC_MODEL=gemma4:e4b-qat-q4_0

# The coder, on another node over the tailnet. This box cannot hold it.
SKETCHGEN_EXECUTOR_MODEL=qwen3-coder:30b-a3b-q4_K_M
SKETCHGEN_EXECUTOR_HOST=http://100.76.50.85:11434

# What the Node card calls this machine, and who operates it.
SKETCHGEN_SHAPE=Retroid Pocket Flip 2 12 GB (SM8250, ROCKNIX)
SKETCHGEN_OPERATOR=profcarroll
