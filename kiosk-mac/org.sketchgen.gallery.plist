<?xml version="1.0" encoding="UTF-8"?>
<!-- ~/Library/LaunchAgents/org.sketchgen.gallery.plist — the wall's own copy of the gallery on
     127.0.0.1:8090 (docs/plans/local-gallery.md §3). Only install.sh with its local option loads it, and only
     on a Mac with the Command Line Tools. install.sh replaces /Users/USER with the account's home. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.sketchgen.gallery</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/USER/Library/sketchgen-kiosk/serve-gallery.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>StandardOutPath</key><string>/Users/USER/Library/Caches/sketchgen-kiosk/gallery.log</string>
  <key>StandardErrorPath</key><string>/Users/USER/Library/Caches/sketchgen-kiosk/gallery.log</string>
</dict>
</plist>
